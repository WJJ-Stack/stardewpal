# ============================================================
# 模型服务配置
# ============================================================
# LLM_PROVIDER 可选：qwen | zhipu | modelscope | siliconflow | mock
#   qwen        阿里云百炼      https://bailian.console.aliyun.com/    新用户 100 万 token
#   zhipu       智谱 GLM        https://open.bigmodel.cn/              glm-4-flash 长期免费
#   modelscope  魔搭免费推理    https://modelscope.cn/                 每日免费调用
#   siliconflow 硅基流动        https://cloud.siliconflow.cn/          注册送额度
#   mock        完全离线，不调模型（用于本地验证链路与 CI）
#
# 不填 key 会自动进入 mock 模式，功能可用但回答由检索片段拼接。
# 切换后自检：python -m backend.pipeline.check_llm
LLM_PROVIDER=qwen
LLM_API_KEY=

# 可选：覆盖 provider 预设的模型/地址（留空则用预设）
LLM_MODEL=
VLM_MODEL=
LLM_BASE_URL=

# ============================================================
# 检索参数
# ============================================================
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_K_FINAL=6
RRF_K=60

# ============================================================
# 视觉链路
# ============================================================
OCR_ENABLED=true
ICON_MATCH_TOPK=3
ICON_CONFIDENCE_HIGH=0.82
ICON_CONFIDENCE_MID=0.55

# ============================================================
# Agent
# ============================================================
MAX_AGENT_STEPS=4
ENABLE_CALCULATOR=true

# ============================================================
# 服务
# ============================================================
HOST=0.0.0.0
PORT=7860
RATE_LIMIT_PER_MIN=30
MAX_IMAGE_MB=8
