# ---- 模型服务 ----
# 不填也能跑（自动进入 mock 模式，用于本地验证链路）
DASHSCOPE_API_KEY=
LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus
VLM_MODEL=qwen-vl-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 检索 ----
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_K_FINAL=6
RRF_K=60

# ---- 视觉 ----
OCR_ENABLED=true
ICON_MATCH_TOPK=3
ICON_CONFIDENCE_HIGH=0.82
ICON_CONFIDENCE_MID=0.55

# ---- Agent ----
MAX_AGENT_STEPS=4
ENABLE_CALCULATOR=true

# ---- 服务 ----
HOST=0.0.0.0
PORT=7860
RATE_LIMIT_PER_MIN=30
MAX_IMAGE_MB=8
